{
  "name": "splk",
  "description": "A web application for folk ensembles",
  "private": true,
  "version": "2026.10.5",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "sync-public": "node scripts/sync-public.mjs",
    "release": "node scripts/release.mjs",
    "frontend:install": "npm --prefix frontend install",
    "frontend:start": "node scripts/build-info.mjs && npm --prefix frontend start",
    "members:import": "node scripts/import-members.mjs",
    "frontend:start:demo": "npm run members:import && node scripts/build-info.mjs && npm --prefix frontend start -- --configuration demo",
    "frontend:build:demo": "node scripts/build.mjs --demo",
    "frontend:build": "node scripts/build.mjs",
    "build": "npm run frontend:build",
    "build-info": "node scripts/build-info.mjs",
    "icons:generate": "node scripts/generate-stitch-icons.mjs",
    "deploy": "node scripts/deploy.mjs",
    "krojarka:start": "npm --workspace apps/krojarka start",
    "krojarka:start:mock": "npm --workspace apps/krojarka start -- --configuration mock",
    "krojarka:test": "npm --workspace apps/krojarka test -- --watch=false",
    "krojarka:build": "npm --workspace apps/krojarka run build",
    "api:install": "docker compose run --rm api composer install",
    "api:test": "docker compose run --rm api composer test",
    "api:migrate": "docker compose run --rm api composer migrate"
  },
  "devDependencies": {
    "ssh2-sftp-client": "^11.0.0"
  }
}
