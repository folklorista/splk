# Angular SPA fallback – neznámé cesty (např. /app/events/5) se mají obsloužit
# přes index.html a routing dořeší Angular na klientovi. Bez tohoto pravidla
# vrátí Apache 404 při reloadu stránky nebo přímém vstupu na URL.
RewriteEngine On

# Existující soubory a složky (JS, CSS, obrázky, ikony...) obsluhovat přímo
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Vše ostatní na index.html
RewriteRule ^ index.html [L]

# Service worker, manifest, index.html a informace o verzi se nesmí agresivně
# cachovat, jinak se aktualizace aplikace k uživatelům nedostane (JS/CSS mají
# hash v názvu, ty cachovat můžou)
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|ngsw-worker\.js|ngsw\.json|manifest\.webmanifest|build-info\.json|changelog\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Neindexovat – aplikace je jen pro členy souboru
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# .htaccess/.htpasswd nikdy nevydávat (deploy ukládá .htpasswd do web rootu)
<Files ".ht*">
  Require all denied
</Files>
