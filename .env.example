# Deploy configuration for scripts/deploy.mjs – copy to .env (git-ignored) and fill in.
# SFTP access (Websupport: port 22, the SFTP root is the web root of the subdomain).
# Quote values containing # or spaces, e.g. SFTP_PASSWORD="ab#cd".
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/

# Public URL of the site (used to verify the deploy)
SITE_URL=https://moje.vonica.cz

# Basic Auth for the whole site – required for the demo build with real members.
# SITE_ROOT_PATH is the absolute path of the web root on the server (AuthUserFile needs it);
# find it e.g. with a temporary PHP file printing __DIR__.
SITE_ROOT_PATH=
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Main vonica.cz hosting account (ftp.vonica.cz) – not used by the deploy script, kept for manual access
VONICA_SFTP_HOST=
VONICA_SFTP_PORT=22
VONICA_SFTP_USER=
VONICA_SFTP_PASSWORD=
