# Hosting and database configuration – copy to .env (git-ignored) and fill in. Never commit real values.
# Quote values containing # or spaces, e.g. MOJE_SFTP_PASSWORD="ab#cd" (process.loadEnvFile treats # as a comment).
# Every domain has its own SFTP account chrooted to its web root (Websupport, SFTP port 22) – scripts never fall back
# from one domain's variables to another's. *_SITE_ROOT_PATH is the absolute web root path on the server
# (needed for AuthUserFile of Basic Auth), e.g. /data/…/vonica.cz/sub/demo.

# Main vonica.cz hosting account – direct access to server root, kept for manual access, do not use if not necessary
VONICA_SFTP_HOST=
VONICA_SFTP_PORT=22
VONICA_SFTP_USER=
VONICA_SFTP_PASSWORD=

# moje.vonica.cz hosting account (scripts/deploy.mjs --target moje)
MOJE_SITE_URL=https://moje.vonica.cz
MOJE_SITE_ROOT_PATH=
MOJE_SFTP_HOST=
MOJE_SFTP_PORT=22
MOJE_SFTP_USER=
MOJE_SFTP_PASSWORD=
MOJE_SFTP_REMOTE_DIR=/
# Basic Auth of moje.vonica.cz – required while it serves the demo build with real members
MOJE_BASIC_AUTH_USER=
MOJE_BASIC_AUTH_PASSWORD=

# demo.vonica.cz hosting account (scripts/deploy.mjs --target demo)
DEMO_SITE_URL=https://demo.vonica.cz
DEMO_SITE_ROOT_PATH=
DEMO_SFTP_HOST=
DEMO_SFTP_PORT=22
DEMO_SFTP_USER=
DEMO_SFTP_PASSWORD=
DEMO_SFTP_REMOTE_DIR=/
DEMO_BASIC_AUTH_USER=
DEMO_BASIC_AUTH_PASSWORD=

# api.vonica.cz hosting account
API_SITE_URL=https://api.vonica.cz
API_SITE_ROOT_PATH=
API_SFTP_HOST=
API_SFTP_PORT=22
API_SFTP_USER=
API_SFTP_PASSWORD=
API_SFTP_REMOTE_DIR=/

# krojarka.vonica.cz hosting account
KROJARKA_SITE_URL=https://krojarka.vonica.cz
KROJARKA_SITE_ROOT_PATH=
KROJARKA_SFTP_HOST=
KROJARKA_SFTP_PORT=22
KROJARKA_SFTP_USER=
KROJARKA_SFTP_PASSWORD=
KROJARKA_SFTP_REMOTE_DIR=/

# krojarka@vonica.cz e-mail account
KROJARKA_EMAIL_ADDRESS=krojarka@vonica.cz
KROJARKA_EMAIL_PASSWORD=
KROJARKA_EMAIL_SMTP_HOST=
KROJARKA_EMAIL_SMTP_PORT=465
KROJARKA_EMAIL_SMTP_SECURE=true

# PostgreSQL 18 – shared database of the API (PHP PDO pdo_pgsql)
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
# disable | require | verify-ca | verify-full
PG_SSLMODE=require
